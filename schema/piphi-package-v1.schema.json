{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.piphi.io/packages/piphi-package-v1.schema.json",
  "title": "PiPhi package envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_schema",
    "id",
    "name",
    "version",
    "roles",
    "deployment"
  ],
  "properties": {
    "package_schema": {
      "const": "piphi.package.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": ".*\\S.*"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "integration_runtime",
          "infrastructure_service",
          "managed_application",
          "widget_package"
        ]
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["in_process", "standalone", "container", "sidecar"]
        }
      }
    },
    "legacy_projection": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "deployment_mode"],
          "properties": {
            "type": {
              "enum": ["integration", "platform_service", "widget"]
            },
            "deployment_mode": {
              "enum": ["standalone", "sidecar"]
            }
          }
        }
      ]
    },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/permission"}
    },
    "compatibility": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/compatibility"}
      ]
    },
    "provides": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/providedInterface"}
    },
    "requires": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/requiredInterface"}
    },
    "lifecycle": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/lifecycle"}
      ]
    },
    "resources": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/resources"}
      ]
    },
    "storage": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/storage"}
    },
    "ui": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/ui"}
      ]
    },
    "automation_adapter": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/automationAdapter"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "legacy_projection": {
            "type": "object",
            "properties": {"type": {"const": "integration"}},
            "required": ["type"]
          }
        },
        "required": ["legacy_projection"]
      },
      "then": {"properties": {"roles": {"contains": {"const": "integration_runtime"}}}}
    },
    {
      "if": {
        "properties": {
          "legacy_projection": {
            "type": "object",
            "properties": {"type": {"const": "platform_service"}},
            "required": ["type"]
          }
        },
        "required": ["legacy_projection"]
      },
      "then": {"properties": {"roles": {"contains": {"const": "infrastructure_service"}}}}
    },
    {
      "if": {
        "properties": {
          "legacy_projection": {
            "type": "object",
            "properties": {"type": {"const": "widget"}},
            "required": ["type"]
          }
        },
        "required": ["legacy_projection"]
      },
      "then": {"properties": {"roles": {"contains": {"const": "widget_package"}}}}
    }
  ],
  "$defs": {
    "declarationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "access", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/declarationId"},
        "access": {"enum": ["read", "write", "control", "admin"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": ".*\\S.*"},
        "required": {"type": "boolean", "default": true}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_version", "platforms", "architectures"],
      "properties": {
        "core_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:(?:~=|==|!=|<=|>=|<|>)[0-9]+(?:\\.[0-9*]+)*(?:[A-Za-z0-9.+-]*)?)(?:\\s*,\\s*(?:~=|==|!=|<=|>=|<|>)[0-9]+(?:\\.[0-9*]+)*(?:[A-Za-z0-9.+-]*)?)*$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["linux", "windows", "macos", "web"]}
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["amd64", "arm64", "armv7", "universal"]}
        }
      }
    },
    "providedInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/declarationId"},
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "requiredInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/declarationId"},
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:(?:~=|==|!=|<=|>=|<|>)[0-9]+(?:\\.[0-9*]+)*(?:[A-Za-z0-9.+-]*)?)(?:\\s*,\\s*(?:~=|==|!=|<=|>=|<|>)[0-9]+(?:\\.[0-9*]+)*(?:[A-Za-z0-9.+-]*)?)*$"
        },
        "optional": {"type": "boolean", "default": false},
        "condition_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/declarationId"}
          ]
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["process", "http", "provider"]},
        "path": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?#])(?!.*://).*$"
            }
          ]
        },
        "interval_seconds": {"type": "integer", "minimum": 5, "maximum": 3600, "default": 30},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60, "default": 5}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "http"}}},
          "then": {"required": ["path"]},
          "else": {"properties": {"path": {"type": "null"}}}
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "health"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["start", "stop", "restart", "update", "backup", "restore"]}
        },
        "health": {"$ref": "#/$defs/health"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cpu_millicores": {"type": "integer", "minimum": 10, "maximum": 64000},
        "memory_mb": {"type": "integer", "minimum": 16, "maximum": 1048576},
        "storage_mb": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/declarationId"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 160},
        "backup": {"type": "boolean", "default": true},
        "retain_on_uninstall": {"type": "boolean", "default": false},
        "size_limit_mb": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 16777216}
          ]
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["application", "administration"]},
        "ingress": {"const": "core_authenticated", "default": "core_authenticated"},
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?#])(?!.*://).*$"
        },
        "supports_websocket": {"type": "boolean", "default": false},
        "show_in_sidebar": {"type": "boolean", "default": false}
      }
    },
    "automationAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contributes"],
      "properties": {
        "contract": {"const": "piphi.automation-adapter.v1", "default": "piphi.automation-adapter.v1"},
        "contributes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["trigger", "check", "action", "result"]}
        }
      }
    }
  }
}
